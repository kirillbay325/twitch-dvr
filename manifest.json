{
  "manifest_version": 3,
  "name": "Twitch DVR Player",
  "version": "1.3.1",
  "description": "Перемотка прямого эфира Twitch, пауза, source из записи трансляции и локальный live-буфер, если VOD отключён.",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["vendor/mux.min.js", "src/styles-inline.js", "src/player.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
